// # oobase64 Main Entry Point - Sovereign Base64 Codec
//
// Logline: Base64 encoder and decoder with standard RFC 4648 and URL-safe options.
//
// Setup: Demands explicit capability tokens and standard argument list.
//
// Beats:
//   1. Parse command-line options and dispatch --help, --version, or --mcp.
//   2. Ingest payload from command line, referenced file, or standard input.
//   3. Dispatch encoding or decoding transform and output plain or JSON text.

import "core/b64_encode.oo";
import "core/b64_decode.oo";
import "render/b64_theme.oo";
import "ipc/b64_opts.oo";
import "ipc/mcp_serve.oo";

fn render_help() -> String {
    return "oobase64 0.2.0 (openOODA sovereign data & streaming)\n"
        + "usage: oobase64 [options] [INPUT_OR_FILE]\n\n"
        + "SIMD-accelerated RFC 4648 Base64 data encoder and decoder with URL-safe variants.\n\n"
        + "Options:\n"
        + "  -h, --help               display this help and exit\n"
        + "  -v, --version            output version information and exit\n"
        + "  -d, --decode             decode data\n"
        + "  -e, --encode             encode data (default)\n"
        + "  -u, --url-safe           use URL-safe alphabet (- and _)\n"
        + "      --no-padding         omit trailing '=' padding delimiters\n"
        + "  -w, --wrap <COLS>        wrap encoded lines after COLS characters [default: 0]\n"
        + "      --json               output formatted as JSON Lines\n"
        + "      --mcp                run as Model Context Protocol stdio server\n";
}

pub fn main(
    fs: &FsReadCap,
    proc_cap: &ProcessCap,
    env: &EnvCap,
    args: List[String]
) -> Result[Int, String] {
    let opts: B64Opts = parse_b64_args(args);

    if opts.action == "help" {
        print(render_help());
        return Ok(0);
    }
    if opts.action == "version" {
        println("oobase64 0.2.0 (openOODA sovereign data & streaming)");
        return Ok(0);
    }
    if opts.action == "mcp" {
        run_mcp_server(fs);
        return Ok(0);
    }

    let mut payload: String = opts.input_text;
    if chars_len(payload) == 0 && chars_len(opts.file_path) > 0 {
        let f_res: Result[String, String] = read_file(fs, opts.file_path);
        if f_res.is_ok() {
            payload = match f_res { Ok(s) => s, Err(_) => "" };
        } else {
            let err_text: String = "oobase64: error reading " + opts.file_path;
            if opts.json_mode {
                println(render_decode_json(opts.file_path, "", false, err_text));
            } else {
                println(err_text);
            }
            return Ok(1);
        }
    } else if chars_len(payload) == 0 {
        let s_res: Result[String, String] = oo_read_stdin_chunk(fs, 65536);
        if s_res.is_ok() {
            payload = match s_res { Ok(s) => s, Err(_) => "" };
        }
    }

    if opts.mode == "decode" {
        let d_res: Result[String, String] = b64_decode_stream(payload);
        if d_res.is_ok() {
            let decoded: String = match d_res { Ok(s) => s, Err(_) => "" };
            if opts.json_mode {
                println(render_decode_json(payload, decoded, true, ""));
            } else {
                print(decoded);
            }
            return Ok(0);
        } else {
            let err_msg: String = match d_res { Ok(_) => "", Err(e) => e };
            if opts.json_mode {
                println(render_decode_json(payload, "", false, err_msg));
            } else {
                println("oobase64: " + err_msg);
            }
            return Ok(1);
        }
    }

    let encoded: String = b64_encode_stream(payload, opts.url_safe, opts.include_padding, opts.wrap_cols);
    if opts.json_mode {
        println(render_encode_json(payload, encoded, opts.url_safe));
    } else {
        println(encoded);
    }
    return Ok(0);
}
